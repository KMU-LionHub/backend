MYSQL_IMAGE=mysql:8.4
BACKEND_IMAGE=ghcr.io/kmu-lionhub/backend:replace-with-commit-sha

DB_NAME=context_stt
DB_USERNAME=context_stt
DB_PASSWORD=replace-with-database-password
MYSQL_ROOT_PASSWORD=replace-with-root-password

CORS_ALLOWED_ORIGINS=https://app.example.com

AUTH_RATE_LIMIT_MAXIMUM_TRACKED_KEYS=20000
AUTH_RATE_LIMIT_SIGNUP_CAPACITY=5
AUTH_RATE_LIMIT_SIGNUP_WINDOW=1m
AUTH_RATE_LIMIT_LOGIN_CAPACITY=10
AUTH_RATE_LIMIT_LOGIN_WINDOW=1m

JWT_SECRET=replace-with-base64-encoded-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_VALIDITY_MS=3600000

STT_GOOGLE_ENABLED=false
GOOGLE_CLOUD_PROJECT=
STT_GOOGLE_LOCATION=asia-northeast1
STT_GOOGLE_MODEL=long
STT_MAX_AUDIO_BYTES=10485760

CLAUDE_API_ENABLED=false
CLAUDE_API_KEY=
CLAUDE_API_BASE_URL=https://api.anthropic.com
CLAUDE_API_MODEL=claude-sonnet-5
CLAUDE_API_MAX_TOKENS=2048
CLAUDE_API_TIMEOUT_SECONDS=30

OPENROUTER_API_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_GEMINI_MODEL=google/gemini-3.7-flash
OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_API_MAX_TOKENS=2048
OPENROUTER_API_TIMEOUT_SECONDS=30
OPENROUTER_SITE_URL=https://api.example.com
OPENROUTER_APP_TITLE=Context STT

CONTEXT_ANALYSIS_MAX_PREVIOUS_UTTERANCES=20
CONTEXT_ANALYSIS_MAX_PREVIOUS_CHARACTERS=12000
CONTEXT_ANALYSIS_RATE_LIMIT_CAPACITY=10
CONTEXT_ANALYSIS_RATE_LIMIT_WINDOW=1m
CONTEXT_ANALYSIS_RATE_LIMIT_MAXIMUM_TRACKED_USERS=10000

SERVER_PORT=8080
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPU_LIMIT=1.0
MYSQL_MEMORY_LIMIT=1g
MYSQL_CPU_LIMIT=1.0
